params {
    // Unique per-invocation id (timestamp), computed once at config parse time.
    // Override with --run_id to pin a name (needed for -resume across launches).
    run_id = new java.text.SimpleDateFormat('yyyyMMdd_HHmmss').format(new Date())

    // Root dir for a profile's run outputs, interpolated into workDir/outdir/cacheDir.
    out_root_local = "${System.getenv('HOME')}/xenium_nb_out"
    out_root_oscer = "/scratch/${System.getenv('USER')}/xenium_nb_out"

    // Required: pipeline step to run. Valid values are main.nf's dispatch block.
    step = null

    // Required: path to a samplesheet CSV (columns vary by step — see main.nf's header)
    samplesheet   = null

    // Output directory for published results
    outdir        = 'results'

    // create_follicle_sdata: CSV mapping cell IDs to samples.
    cell_ids_file = "${launchDir}/assets/stage_quality_area_all_rois.csv"

    // create_follicle_sdata: bounding box radius (µm) around each cell centroid.
    // Overridable per-cell via a 'radius' column in cell_ids_file.
    radius        = 100

    // downsample_sdata: fraction of cells to retain, or an absolute count.
    fraction      = 0.1
    n_cells       = null

    // cluster_sdata_gpu_ooc: row chunk size for the lazily-loaded X matrix.
    chunk_size    = 20000

    // cluster_sdata_gpu_ooc: hard-subset to this many HVGs before PCA. Off by
    // default because it clusters a different feature space than the other two
    // steps; set it only if the materialized X will not fit on the GPU.
    n_top_genes   = null

    // cluster_sdata*: comma-separated Leiden resolutions to sweep, e.g.
    // --resolutions 0.5,1.0,1.5. One `leiden_res_<r>` obs column per value.
    //
    // These four and n_top_genes above are null so the default lives in exactly
    // one place, bin/cluster_sdata*.py — do not restate the values here.
    resolutions   = null

    // cluster_sdata*: the filtering cut. min_counts drops cells below that many
    // transcripts; min_cells masks genes detected in fewer cells; max_counts_quantile
    // is an upper cell cut (0 disables). Read them off qc_report's retention curves.
    // Overridable per-sample by a same-named samplesheet column (see resolveThreshold
    // in main.nf); 0 is a meaningful value here, not "unset".
    min_counts    = null
    min_cells     = null
    max_counts_quantile = null

    // create_centroids: the obs column to sum cells over. Null means the leiden sweep,
    // which is the store every deck reads; set, it names a column some upstream step
    // already wrote (per-cell cell type being the case it exists for). A --group_by run
    // writes <sample>_centroids_<column>.h5ad, so it never displaces the sweep store.
    // Null here so the default lives only in bin/create_centroids.py.
    group_by      = null

    // sample_summary: the immune subtype assets, both built by
    // scripts/convert_ovary_reference.py from the same paper as reference_major. The
    // markers are the paper's own text markers verbatim; the reference is Data S7's
    // four subtype centroids. They drive one evidence slide per sample.
    immune_markers   = "${launchDir}/assets/ovary_immune_markers.yaml"
    reference_immune = "${launchDir}/assets/ovary_reference_immune.csv.gz"

    // sample_summary: which resolution from the cluster_sdata* sweep each sample is
    // reported at. Rows are OVERRIDES, so the shipped asset is header-only and a
    // cohort renders before any resolution has been chosen.
    chosen_resolutions = "${launchDir}/assets/chosen_resolutions.csv"

    // sample_summary: follicle marker sets scored per cell, and genes x major cell
    // type mean expression correlated against each cluster centroid. Both built from
    // Sci Adv adm7506 by scripts/convert_ovary_reference.py — tissue-specific, so
    // point them at your own assets for a different tissue.
    follicle_markers   = "${launchDir}/assets/ovary_follicle_markers.yaml"
    reference_major    = "${launchDir}/assets/ovary_reference_major.csv.gz"

    // sample_summary: hand-made cell type calls, one row per sample and cell type.
    // Rows are OVERRIDES on the deck's argmax and a blank cluster means "not present",
    // so the shipped asset is header-only. Edit the deck's emitted
    // cluster_annotations.csv and point this at it.
    cell_type_annotations = "${launchDir}/assets/cell_type_annotations.csv"

    // sample_summary: hand-curated putative oocytes with stage/quality/area, driving
    // the per-stage zoom slides.
    //
    // Deliberately NOT params.cell_ids_file, which points at this same asset:
    // create_follicle_sdata's contract is cell_id plus an optional radius, and its
    // other valid inputs carry no stage or quality columns. Sharing one param would
    // make a valid create_follicle_sdata input a hard failure here.
    curated_oocytes = "${launchDir}/assets/stage_quality_area_all_rois.csv"

}

profiles {
    local {
        // One self-contained dir per run — <out_root>/<run_id>/{work,results} — kept
        // out of the repo, so a whole run is a single unit to size or prune. work and
        // results share a root to stay on one filesystem, which the modules' hardlink
        // publishing needs.
        workDir = "${params.out_root_local}/${params.run_id}/work"

        // Drop the work dir on success so only the hardlinked results survive.
        // Success-scoped, so resume-after-failure still works; it forfeits only
        // resume-from-success, which this pipeline rarely uses.
        cleanup = true

        // Constrain local runs to avoid host OOM/restarts on laptop-class machines.
        params {
            samplesheet   = "${launchDir}/assets/samplesheet.csv"
            cell_ids_file = "${launchDir}/assets/test_cell_ids.csv"
            outdir        = "${params.out_root_local}/${params.run_id}/results"
        }
        process {
            executor      = 'local'
            // Ships the full RAPIDS + spatialdata/squidpy/Quarto stack, so it is the
            // container for every process, not just the GPU steps.
            container     = 'babiddy755/python_spatial:1.2.0'
            cpus          = 8
            memory        = '16 GB'
            maxForks      = 1
            errorStrategy = 'finish'

            withName: 'CLUSTER_SDATA_GPU|CLUSTER_SDATA_GPU_OOC' {
                // Apptainer's `--nv` does not work under WSL2: it injects driver
                // libs piecemeal, but the WSL `libcuda.so` shim must load its
                // companions from /usr/lib/wsl/lib together to reach the GPU via
                // /dev/dxg. Bind the whole WSL driver dir and put it first on the
                // loader path instead. CONDA_PREFIX is also required: cupy's CUDA
                // header autodetection for JIT kernel compiles keys off it, and
                // micromamba never sets it in the non-login shell `script:` uses.
                containerOptions = '--bind /usr/lib/wsl' +
                    ' --env LD_LIBRARY_PATH=/usr/lib/wsl/lib:/usr/local/nvidia/lib:/usr/local/nvidia/lib64' +
                    ' --env CONDA_PREFIX=/opt/conda/envs/python_spatial'
            }
        }
        apptainer {
            enabled    = true
            runOptions = '--writable-tmpfs'
            // A SIBLING of the per-run dirs, never nested under a run_id: cacheDir
            // otherwise defaults to <workDir>/singularity, and since workDir carries a
            // per-run id, every run would re-pull and re-convert the image.
            cacheDir   = "${params.out_root_local}/apptainer_cache"
        }
    }

    oscer {
        // Both work dir and results on scratch, the large compute-node-accessible
        // filesystem — home is small and not meant for pipeline I/O. Same one-dir-per-run
        // layout as the local profile above, for the same reasons.
        workDir = "${params.out_root_oscer}/${params.run_id}/work"

        // As local, and the main lever against scratch quota pressure. (cleanup is
        // unsupported for remote work dirs, but OSCER scratch is POSIX, so it applies.)
        cleanup = true

        params {
            outdir = "${params.out_root_oscer}/${params.run_id}/results"
        }

        process {
            executor      = 'slurm'
            queue         = 'normal'
            container     = 'babiddy755/python_spatial:1.2.0'
            // The `normal` partition allows 48 h / ~250 GB / 64 cores per node.
            cpus          = 16
            memory        = { 48.GB * task.attempt }
            time          = { 4.h + (task.attempt - 1) * 4.h }
            errorStrategy = 'retry'
            maxRetries    = 3

            // Single-GPU RAPIDS, so `--gres=gpu:1` suffices; `--nv` exposes the
            // driver (the WSL2 shim above is not needed on real HPC). CONDA_PREFIX
            // is, for the same reason it is set there: cupy JIT-compiles its
            // elementwise kernels and finds the CUDA headers under
            // $CONDA_PREFIX/targets/<arch>-linux, but the non-login shell `script:`
            // uses never sets it, so the first compiled kernel (the >= in
            // filter_cells) dies with "Failed to find CUDA headers".
            //
            // The H100 partition rather than the mixed `sooner_gpu_test`, which spans
            // L40S / H100 / RTX 6000 Ada: pinning the card guarantees the 80 GB, which
            // is what decides whether a table needs the out-of-core step at all, and
            // keeps timings comparable run to run.
            withName: 'CLUSTER_SDATA_GPU|CLUSTER_SDATA_GPU_OOC' {
                queue            = 'sooner_gpu_test_h100'
                clusterOptions   = '--gres=gpu:1'
                containerOptions = '--nv --env CONDA_PREFIX=/opt/conda/envs/python_spatial'
            }
        }
        apptainer {
            enabled     = true
            runOptions  = '--writable-tmpfs'
            // CUDA_VISIBLE_DEVICES must survive into the container or the GPU steps
            // run on the wrong card. Nextflow's launcher wraps `apptainer exec` in
            // `env -`, which rebuilds the environment from PATH and a few NXF vars and
            // drops everything else — including the variable SLURM sets to name the GPU
            // `--gres=gpu:1` allocated. With `--nv` exposing every card on the node and
            // nothing left to narrow the choice, cupy takes device 0 regardless of the
            // allocation. On a node whose device 0 is held by another job, that is an
            // immediate out-of-memory on an allocation of a few hundred MB while the
            // allocated card sits idle — observed on c1037, where all six samples were
            // serialised through one free GPU and all 19 attempts died this way.
            // (Only bites because this partition does not set cgroup ConstrainDevices,
            // which would hide unallocated cards from the job outright.)
            envWhitelist = 'CUDA_VISIBLE_DEVICES'
            // A SIBLING of the per-run dirs, never nested under a run_id — otherwise
            // every run re-pulls and re-converts this large image on a compute node.
            cacheDir    = "${params.out_root_oscer}/apptainer_cache"
            // The OCI→SIF conversion of this image on scratch is slow; the 20m
            // default pullTimeout gets killed (exit 143) mid-conversion.
            pullTimeout = '2h'
        }
    }
}

// Execution timeline written to the results directory
timeline {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/timeline.html"
}

// Detailed resource usage report written to the results directory
report {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/report.html"
}

manifest {
    name        = 'xenium_nb'
    description = 'Nextflow pipeline for Xenium spatial transcriptomics analysis using Quarto notebooks'
    version     = '0.1.0'
    nextflowVersion = '>=25.10.0'
}
